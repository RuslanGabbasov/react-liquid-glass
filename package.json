{
  "name": "react-glass",
  "version": "1.0.0",
  "description": "React component for Apple Liquid Glass effect — CSS blur + WebGPU refractive edge",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly --declaration --outDir dist",
    "dev": "vite",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react",
    "glass",
    "glassmorphism",
    "webgpu",
    "liquid-glass",
    "backdrop-filter",
    "refraction",
    "apple"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/react-glass"
  }
}